# Database (MongoDB)
DATABASE_URI=mongodb://localhost:27017/giveawaypremium

# Parse Server
APP_ID=myAppId
APP_NAME=GiveawayPremium
MASTER_KEY=myMasterKey
CLIENT_KEY=myClientKey
JAVASCRIPT_KEY=myJavascriptKey
REST_API_KEY=myRestAPIKey
SERVER_URL=http://localhost:1337/api

# Cloud code path (absolute path to compiled cloud/main.js, defaults to dist/cloud/main.js)
# CLOUD=/app/dist/cloud/main.js

# Parse Dashboard
PARSE_DASHBOARD_USERNAME=admin
PARSE_DASHBOARD_PASSWORD=your_secure_password
PARSE_DASHBOARD_COOKIE_SESSION_SECRET=myCookieSecret
PARSE_DASHBOARD_INSECURE_HTTP=true
PARSE_DASHBOARD_TRUST_PROXY=1
PARSE_DASHBOARD_ENCRYPTED=false

# Other services (optional)
PORT=1337
CLOUDINARY_NAME=demo
CLOUDINARY_API_KEY=demo_key
CLOUDINARY_API_SECRET=demo_secret

# Parse Server - class creation (set to false in production)
# ALLOW_CLIENT_CLASS_CREATION=true

# CORS (comma-separated origins, leave empty to allow all origins)
# CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Email (Gmail example)
MAIL_ADDRESS=your@gmail.com
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

# GHTK
GHTK_TOKEN=your_ghtk_token
GHTK_URL=https://services.ghtk.vn

# Nhanh
NHANH_SERVER=https://dev.nhanh.vn
NHANH_VERSION=1.0
NHANH_SECRET_KEY=your_key
NHANH_API_USERNAME=your_username

# Schedule
ACTIVE_CAMPAIGN_SCHEDULE=0 * * * * *
