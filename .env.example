# Database (MongoDB)
DATABASE_URI=mongodb://localhost:27017/giveawaypremium

# Parse Dashboard
PARSE_DASHBOARD_USERNAME=admin
PARSE_DASHBOARD_PASSWORD=your_secure_password
PARSE_DASHBOARD_COOKIE_SESSION_SECRET=myCookieSecret
PARSE_DASHBOARD_INSECURE_HTTP=true
PARSE_DASHBOARD_TRUST_PROXY=1
PARSE_DASHBOARD_ENCRYPTED=false
# URL mà Dashboard (chạy trong browser) dùng để gọi Parse Server API.
# PHẢI là URL public thật (giống SERVER_URL) — KHÔNG dùng localhost trên production,
# vì browser sẽ cố gọi localhost của máy người dùng, không phải server.
DASHBOARD_SERVER_URL=https://goldfish-app-pgzae.ondigitalocean.app/parse

# Other services (optional)
PORT=1337
CLOUDINARY_NAME=demo
CLOUDINARY_API_KEY=demo_key
CLOUDINARY_API_SECRET=demo_secret

# Email (Gmail example)
MAIL_ADDRESS=your@gmail.com
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

# GHTK
GHTK_TOKEN=your_ghtk_token
GHTK_URL=https://services.ghtk.vn

# ViettelPost
VIETTELPOST_TOKEN=your_viettelpost_token
VIETTELPOST_URL=https://partner.viettelpost.vn/v2
VIETTELPOST_USERNAME=your_viettelpost_username
VIETTELPOST_PASSWORD=your_viettelpost_password

# SePay — đối chiếu sao kê ngân hàng cho báo cáo kiểm kê (/admin/bao-cao)
# Webhook: my.sepay.vn → Webhooks → URL https://<domain>/hooks/sepay, sự kiện "Cả hai"
# (tiền vào + tiền ra). Chọn MỘT kiểu chứng thực rồi điền khoá tương ứng bên dưới;
# nếu để trống cả hai, server từ chối mọi webhook SePay.
#   HMAC-SHA256 (khuyến nghị) → SEPAY_WEBHOOK_SECRET
#   API Key                    → SEPAY_WEBHOOK_API_KEY
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=
# API token (my.sepay.vn → Cấu hình công ty → API Access). Dùng để bù giao dịch của
# giai đoạn chưa bật webhook (nút "Đồng bộ SePay"). Chỉ để ở server.
SEPAY_API_TOKEN=
# Tuỳ chọn: chỉ nhận giao dịch của các số tài khoản này (cách nhau bằng dấu phẩy).
# Để trống = nhận tất cả tài khoản đã liên kết trong SePay.
SEPAY_ACCOUNT_NUMBERS=

# Nhanh
NHANH_SERVER=https://dev.nhanh.vn
NHANH_VERSION=1.0
NHANH_SECRET_KEY=your_key
NHANH_API_USERNAME=your_username

# Schedule
ACTIVE_CAMPAIGN_SCHEDULE=0 * * * * *
